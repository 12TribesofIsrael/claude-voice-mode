# Local flag/backup artifacts — nothing here should be committed
*.bak
settings.json
claude-voice-*.txt

# Secrets / local runtime — never commit the API key or its config
voice-config.json
webapp/__pycache__/
__pycache__/

# Personal reading material — keep PDFs and reading progress out of the public repo
documents/*.pdf
documents/.read-progress.json

# Document reader working store — the documents you open, the audio generated
# from them, and how far through each one you are. Personal by definition, and
# the audio cache runs to hundreds of megabytes.
webapp/.reader/
